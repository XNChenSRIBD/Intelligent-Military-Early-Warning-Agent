APP_HOST=127.0.0.1
APP_PORT=8080
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_NAME=qwen3-4b
MODEL_API_KEY=
MODEL_TIMEOUT=120
MODEL_MAX_TOKENS=1800
DISABLE_THINKING=true
SOURCE_TIMEOUT=25
REQUEST_MAX_BYTES=2000000
ARTICLE_CHARS=1800
RSS_URL=https://news.un.org/feed/subscribe/en/news/all/rss.xml
PORTWATCH_URL=https://services9.arcgis.com/weJ1QsnbMYJlCHdG/ArcGIS/rest/services/Daily_Chokepoints_Data/FeatureServer/0
PORTWATCH_ID=chokepoint6
# PortWatch numerical monitoring: defaults are engineering settings, not calibrated thresholds.
# Change PW_RULE_ID together with rule parameters to preserve previous decision records.
PW_RULE_ID=pw_lowflow_v1
PW_HISTORY_DAYS=90
PW_BASELINE_DAYS=28
PW_MIN_BASELINE_DAYS=21
PW_TRIGGER_RATIO=0.5
PW_TRIGGER_DAYS=2
PW_RECOVERY_RATIO=0.8
PW_RECOVERY_DAYS=2
# Automatic pipeline. Source/topic/interval defaults seed the first saved configuration;
# later dashboard changes and the pause state persist in SQLite. This switch remains authoritative.
PIPELINE_ENABLED=true
PIPELINE_NEWS_TOPIC='(Hormuz OR "Strait of Hormuz") (shipping OR tanker OR cargo OR maritime)'
PIPELINE_RSS_TERMS=Hormuz,shipping,tanker,maritime
PIPELINE_SOURCES=gdelt,rss,portwatch
# Polling intervals in seconds; these do not promise source freshness.
PIPELINE_NEWS_INTERVAL=300
PIPELINE_PORTWATCH_INTERVAL=86400
PIPELINE_LOOKBACK_HOURS=48
PIPELINE_OVERLAP_MINUTES=30
# News model batches are capped at 3; collection is not capped by this value.
PIPELINE_BATCH_SIZE=3
PIPELINE_ANALYSIS_VERSION=shipping_v1
PIPELINE_TOOL_CALLS=2
PIPELINE_MODEL_REQUESTS=4
PIPELINE_SOURCE_CONCURRENCY=2
# Maximum GDELT windows requested per source check; unfinished coverage resumes later.
PIPELINE_SEARCH_WINDOWS=8
PIPELINE_RETRY_SECONDS=60
PIPELINE_RETRY_MAX_SECONDS=3600
# Historical automatic replay is opt-in; online remains the default.
# Use scripts/start_case_replay.ps1 or start_case_replay.sh to set a separate DATA_DIR.
PIPELINE_MODE=online
REPLAY_MANIFESTS=cases/replay/kharkiv/manifest.json;cases/replay/hormuz/manifest.json
# Root containing raw/cddis_daily, raw/cddis_highrate, etc.; set a local path when running replay.
# REPLAY_ASSET_ROOT=/path/to/chasing_lightning
REPLAY_AUTOSTART=true
REPLAY_MAX_ATTEMPTS=3

# Round 5: server-owned acquisition/catalog shared by online and replay.
# Existing DATA_DIR is preserved; production startup example: scripts/start_server_data.sh
SERVER_ASSET_ROOT=/home/xnchen/gnss_public_data/chasing_lightning
SERVER_RUNTIME_ROOT=/home/xnchen/gnss_public_data/early_warning_runtime
ACQUISITION_ENABLED=false
ACQUISITION_AUTOCLEAN=false
# Server startup enables acquisition. Enable cleanup explicitly with ACQUISITION_AUTOCLEAN=true
# on first catalog initialization, or save autoclean=true in the server policy UI.
# Saved catalog policy takes precedence after its first initialization.
DATA_DIR=./runtime
